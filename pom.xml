<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.integratedmodelling</groupId>
    <artifactId>klab.component.archetype</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>maven-archetype</packaging>

    <name>k.LAB component Maven archetype</name>
    <description>Maven archetype for creating configurable k.LAB component projects</description>
    <url>https://github.com/integratedmodelling/klab.component.archetype</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven-archetype.version>3.4.1</maven-archetype.version>
    </properties>

    <licenses>
        <license>
            <name>GNU Affero General Public License (AGPL) version 3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.en.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ferdinando Villa</name>
            <email>ferdinando.villa@bc3research.org</email>
            <organization>Basque Centre for Climate Change (BC3); IKERBASQUE, Basque foundation for science</organization>
            <organizationUrl>https://www.bc3research.org</organizationUrl>
        </developer>
        <developer>
            <name>Enrico Girotto</name>
            <email>enrico.girotto@bc3research.org</email>
            <organization>Basque Centre for Climate Change (BC3)</organization>
            <organizationUrl>https://www.bc3research.org</organizationUrl>
        </developer>
        <developer>
            <name>Andrea Antonello</name>
            <email>andrea.antonello@gmail.com</email>
            <organization>HydroloGIS Environmental Engineering</organization>
            <organizationUrl>https://www.hydrologis.com/</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/integratedmodelling/klab.component.archetype.git</connection>
        <developerConnection>scm:git:https://github.com/integratedmodelling/klab.component.archetype.git</developerConnection>
        <url>https://github.com/integratedmodelling/klab.component.archetype.git</url>
        <tag>HEAD</tag>
    </scm>

    <organization>
        <name>integratedmodelling.org</name>
        <url>https://www.integratedmodelling.org</url>
    </organization>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://ossrh-staging-api.central.sonatype.com/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <build>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>${maven-archetype.version}</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
                <version>${maven-archetype.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
