<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.integratedmodelling</groupId>
        <artifactId>klab-services</artifactId>
        <version>${klabVersion}</version>
        <relativePath/>
    </parent>

    <groupId>${groupId}</groupId>
    <artifactId>${artifactId}</artifactId>
    <version>${version}</version>
    <name>${artifactId}</name>
    <description>${componentDescription}</description>
    <url>https://github.com/integratedmodelling/${artifactId}</url>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <klab.version>${klabVersion}</klab.version>
    </properties>

    <licenses>
        <license>
            <name>${licenseName}</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.en.html</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/integratedmodelling/${artifactId}.git</connection>
        <developerConnection>scm:git:https://github.com/integratedmodelling/${artifactId}.git</developerConnection>
        <url>https://github.com/integratedmodelling/${artifactId}.git</url>
        <tag>HEAD</tag>
    </scm>

    <organization>
        <name>${vendorName}</name>
        <url>https://www.integratedmodelling.org</url>
    </organization>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://ossrh-staging-api.central.sonatype.com/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>klab.core.services</artifactId>
            <version>${klabVersion}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.integratedmodelling</groupId>
                <artifactId>klab.product</artifactId>
                <version>${klabProductVersion}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>package-component</goal>
                        </goals>
                        <configuration>
                            <componentName>${artifactId}</componentName>
                            <componentDescription>${componentDescription}</componentDescription>
                            <componentVendorName>${vendorName}</componentVendorName>
                            <componentVendorEmail>${vendorEmail}</componentVendorEmail>
                            <componentLicenseName>${licenseName}</componentLicenseName>
                            <componentUsageRights>${usageRights}</componentUsageRights>
                            <componentClass>${package}.ComponentPlugin</componentClass>
                            <componentVersion>${version}</componentVersion>
                            <hostRuntimeArtifacts>
                                org.integratedmodelling:klab.service.runtime.server:${klabVersion},
                                org.integratedmodelling:klab.service.resources.server:${klabVersion}
                            </hostRuntimeArtifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
